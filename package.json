{
  "name": "gpx-privacy",
  "version": "0.1.1",
  "description": "Edit a GPX file for sharing: trim the start and end, simplify the track, compute distance and climb, and write a clean GPX file.",
  "keywords": [
    "edit gpx file",
    "trim gpx file",
    "strava privacy zones",
    "gpx parser",
    "gpx simplify",
    "gpx",
    "gps",
    "privacy",
    "trim",
    "simplify",
    "track",
    "strava",
    "cycling",
    "running",
    "cli"
  ],
  "homepage": "https://oss.saimulislam.com/gpx-privacy/",
  "bugs": {
    "url": "https://github.com/saimulft/gpx-privacy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saimulft/gpx-privacy.git"
  },
  "license": "MIT",
  "author": "Saimul Islam (https://github.com/saimulft)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gpx-privacy": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint . && npm run lint:names",
    "lint:names": "ls-lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1"
  }
}
